# PowerShell example: $env:CLOUD_DIARY_ENV="development"
CLOUD_DIARY_ENV=development
CLOUD_DIARY_SECRET_KEY=replace-with-a-long-random-production-secret
# 用于 canonical、RSS 与站点地图的站点根地址（末尾不带斜杠）
CLOUD_DIARY_SITE_URL=http://127.0.0.1:5000
# 可选：将数据库、上传和备份迁移到指定的本地绝对路径
# CLOUD_DIARY_INSTANCE_PATH=D:\cloud-diary-instance

# 云门（Cloudgate）接入参数全部在博客后台“登录与注册”中维护。
# Client Secret会使用博客SECRET_KEY派生密钥加密后保存在本地SQLite。
