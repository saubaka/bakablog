# Copy values into the service manager or machine environment; do not commit real secrets.
CLOUD_DIARY_ENV=production
CLOUD_DIARY_SECRET_KEY=replace-with-at-least-32-random-bytes
CLOUD_DIARY_SITE_URL=https://blog.example.com
CLOUD_DIARY_INSTANCE_PATH=/var/lib/bakablog

# Linux: bakagate chooses an available 127.0.0.1 port and keeps nginx in sync.
# macOS: deploy-macos.sh writes a private copy under
# ~/Library/Application Support/BakaBlog/config/production.env and launchd
# starts Gunicorn on the explicitly selected loopback port.
CLOUD_DIARY_TRUST_PROXY_HEADERS=1

# nginx/Caddy handles compression; keep all assets and dependencies local.
CLOUD_DIARY_TEXT_COMPRESSION=0

# Optional during controlled secret rotation; remove after old sessions expire.
# CLOUD_DIARY_SECRET_KEY_FALLBACKS=previous-secret-with-at-least-32-random-bytes
