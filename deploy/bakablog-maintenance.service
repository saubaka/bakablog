[Unit]
Description=Baka Blog maintenance (daily backup when due, daily clean-up, scheduled chores)
After=bakablog.service

[Service]
Type=oneshot
User=bakablog
Group=bakablog
WorkingDirectory=/opt/bakablog/current/backend
EnvironmentFile=/etc/bakablog/production.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/bakablog/venv/bin/flask --app app maintenance
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/bakablog
UMask=0027
