# /etc/nginx/sites-available/bakablog   (replace blog.example.com; get the certificate with certbot or your own means)
#
# nginx 1.18+ (Debian 12 has 1.22). The application sets its own security headers (CSP, HSTS, frame, referrer ...), so the proxy adds none
# of those; it only forwards the real client address and scheme, compresses text, and sets sensible limits.

upstream bakablog {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name blog.example.com;
    # ACME challenges would go here; everything else moves to https
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name blog.example.com;

    ssl_certificate     /etc/letsencrypt/live/blog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blog.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 20m;                       # pictures (BLOG_MAX_UPLOAD_MB is 12)
    keepalive_timeout 15s;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml application/rss+xml application/atom+xml image/svg+xml application/manifest+json;

    location / {
        proxy_pass http://bakablog;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Restoring a backup / importing Markdown uploads a whole archive (the app caps them itself: 2 GB and 600 MB). Only the admin API needs the room.
    location /api/admin/system/ {
        client_max_body_size 2g;
        client_body_timeout 300s;
        proxy_request_buffering off;
        proxy_pass http://bakablog;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    access_log /var/log/nginx/bakablog.access.log;
    error_log  /var/log/nginx/bakablog.error.log warn;
}
