# /etc/bakablog/production.env  —  owner root, mode 0600 (systemd reads it as root; nothing else needs to).
# Real environment variables win over this file. Lines starting with # are comments.

BLOG_ENV=production

# At least 32 random characters. It signs preview links; changing it invalidates those links, nothing else.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BLOG_SECRET_KEY=__GENERATE_ME__

# The one address the site is known by (feeds, sitemap and canonical links use it; the Host header never decides). No trailing slash.
BLOG_SITE_URL=https://blog.example.com

# Where the data lives: blog.sqlite, media/, backups/. Back this folder up off the machine (the in-app backups are in backups/ inside it).
BLOG_DATA_DIR=/var/lib/bakablog

# The built front end of the release in use
BLOG_FRONTEND_DIST=/opt/bakablog/current/frontend/dist

# How many reverse proxies sit in front (nginx = 1): the client address and the scheme come from X-Forwarded-*
BLOG_TRUST_PROXY=1

# Cookies are Secure in production. Leave it on; the site is served over https.
BLOG_COOKIE_SECURE=true

# Largest picture upload in MB (the proxy's client_max_body_size must be larger)
BLOG_MAX_UPLOAD_MB=12

BLOG_LOG_LEVEL=INFO

# The one-time token that opens /admin/setup (the deploy script generates it; it is never printed anywhere else). Read it here, create the
# administrator, and delete this line afterwards: once an administrator exists the token does nothing.
BLOG_SETUP_TOKEN=__GENERATE_TOKEN__
